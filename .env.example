# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Telegram (required) ---------------------------------------------------
# Create an app at https://my.telegram.org/apps to get these two values.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Get your bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=1234567890:AABBccDDeeFFggHHiiJJkkLLmmNNoo

# --- RDMNS (optional) -------------------------------------------------------
# 16-character hex android_id sent as the `did` query parameter.
# The default below is from the captured test device — works fine unless the
# server starts checking for uniqueness.
RDMNS_DEVICE_ID=8b8c5ba96f2d5f5a
